{
  "name": "dsh-stall-guard",
  "version": "0.1.3",
  "description": "DSH 卡顿守卫：下载类命令（git clone / pnpm install / pip / curl）超时后自动中止，并把「换个下载源重试」的提示写进工具结果给智能体看，解决 GitHub 在国内网络不稳导致智能体一直干等的问题。另可按工具类型自定义超时秒数，并附一个只在卡顿时唤醒的 DeepSeek 监督员。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "timeout",
    "download",
    "mirror",
    "github",
    "gitee",
    "proxy",
    "stall",
    "watchdog",
    "agent"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "PROVENANCE.md"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1250589385/dsh-stall-guard.git"
  },
  "bugs": {
    "url": "https://github.com/1250589385/dsh-stall-guard/issues"
  },
  "homepage": "https://github.com/1250589385/dsh-stall-guard#readme",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}